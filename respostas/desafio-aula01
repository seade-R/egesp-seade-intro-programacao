library(tidyverse)                     # pacote principal para manipulação de dados

# Carregando dados de COVID-19 dos municípios de SP
url_covid <- 'https://raw.githubusercontent.com/seade-R/seade-intro-programacao/master/data/dados_covid_sp.csv'
covid <- read_csv2(url_covid)


# ----------------------------------------------------------------------------
# 1) Resumo — Aula 1: Primeiros passos com R e dplyr -------------------------
# ----------------------------------------------------------------------------

# 1.1 RStudio e conceitos fundamentais ---------------------------------------
# Na primeira aula aprendemos:
# - Interface do RStudio: Console, Environment, Files, Plots
# - Data frames: estrutura retangular (linhas = observações, colunas = variáveis)
# - Pipe (%>%): operador que "passa" o resultado de uma função para a próxima
# - Objetos e atribuição (<-): como armazenar dados na memória
# - Instalação e carregamento de pacotes: install.packages() e library()


# 1.2 Os verbos básicos do dplyr ---------------------------------------------

# 1.2.1 Explorando os dados inicialmente
head(covid)        # primeiras 6 linhas
tail(covid)        # últimas 6 linhas  
nrow(covid)        # número de linhas
ncol(covid)        # número de colunas
names(covid)       # nomes das variáveis
glimpse(covid)     # visão geral estruturada


# 1.2.2 rename(): renomear variáveis para facilitar o trabalho
covid <- covid %>% 
  rename(municipio = nome_munic,
         drs = nome_drs,
         data = datahora,
         populacao = pop)


# 1.2.3 select(): selecionar colunas de interesse
covid %>%
  select(municipio, data, casos, obitos, populacao) %>%
  head(3)

# Também funciona para excluir colunas (com -)
covid %>%
  select(-codigo_ibge) %>%
  head(3)


# 1.2.4 filter(): filtrar linhas baseado em condições
# Apenas município de São Paulo
covid %>%
  filter(municipio == "Sao Paulo") %>%
  head(3)

# Apenas data específica  
covid %>%
  filter(data == "2020-08-03") %>%
  head(3)

# Combinando condições (E)
covid %>%
  filter(municipio == "Sao Paulo" & data == "2020-08-03")

# Combinando condições (OU)
covid %>%
  filter(municipio == "Sao Paulo" | municipio == "Campinas") %>%
  head(3)


# 1.2.5 mutate(): criar ou transformar variáveis
covid <- covid %>%
  mutate(
    obitos_pc = (obitos / populacao) * 100000,      # óbitos por 100 mil hab
    casos_pc = (casos / populacao) * 100000,        # casos por 100 mil hab  
    letalidade = obitos / casos                     # taxa de letalidade
  )


# 1.2.6 arrange(): ordenar linhas
covid %>%
  arrange(desc(obitos_pc)) %>%          # maiores taxas de óbitos primeiro
  head(3)

covid %>%
  arrange(municipio, data) %>%          # ordenar por município e depois data
  head(3)


# 1.2.7 group_by() + summarise(): agregações por grupos
covid %>%
  group_by(drs) %>%
  summarise(
    obitos_totais = sum(obitos_novos),
    casos_totais = sum(casos_novos),
    municipios = n_distinct(municipio)   # quantos municípios únicos por DRS
  ) %>%
  arrange(desc(obitos_totais))


