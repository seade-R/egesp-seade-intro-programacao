# 2.1 Análise dos municípios com maior impacto da COVID-19 ------------------

# Vamos criar diferentes perspectivas de análise dos dados:

# A) Top 10 municípios por óbitos totais no dia 03/08/2020
top_obitos_absolutos <- covid %>%
  filter(data == "2020-08-03") %>%
  select(municipio, obitos, populacao, obitos_pc) %>%
  arrange(desc(obitos)) %>%
  head(10)

print("Top 10 municípios por óbitos absolutos:")
print(top_obitos_absolutos)

# B) Top 10 municípios por óbitos per capita no dia 03/08/2020  
top_obitos_per_capita <- covid %>%
  filter(data == "2020-08-03") %>%
  select(municipio, obitos, populacao, obitos_pc) %>%
  arrange(desc(obitos_pc)) %>%
  head(10)

print("Top 10 municípios por óbitos per capita:")
print(top_obitos_per_capita)


# 2.2 Categorização de municípios por porte populacional --------------------
covid_categorizado <- covid %>%
  mutate(
    porte_municipio = ifelse(populacao < 20000, "Pequeno",
                      ifelse(populacao < 100000, "Médio", 
                      ifelse(populacao < 500000, "Grande", "Metrópole"))),
    
    gravidade_obitos = ifelse(obitos_pc < 50, "Baixa",
                       ifelse(obitos_pc < 100, "Moderada", "Alta"))
  )

# Análise por porte de município na data final
covid_categorizado %>%
  filter(data == "2020-08-03") %>%
  group_by(porte_municipio) %>%
  summarise(
    quantidade_municipios = n(),
    obitos_totais = sum(obitos),
    casos_totais = sum(casos),
    obitos_pc_media = round(mean(obitos_pc), 1),
    letalidade_media = round(mean(letalidade, na.rm = TRUE), 4)
  )


# 2.3 Evolução temporal em grandes centros -----------------------------------
# Analisando a evolução da pandemic nos 5 maiores municípios por população

maiores_municipios <- covid %>%
  filter(data == "2020-08-03") %>%
  arrange(desc(populacao)) %>%
  head(5) %>%
  pull(municipio)  # extraindo apenas os nomes para filtrar depois

# Evolução semanal nestes municípios (usando only algumas datas)
evolucao_grandes_centros <- covid %>%
  filter(
    municipio %in% maiores_municipios,
    data %in% c("2020-03-15", "2020-04-15", "2020-05-15", 
                "2020-06-15", "2020-07-15", "2020-08-03")
  ) %>%
  select(municipio, data, casos, obitos, casos_pc, obitos_pc) %>%
  arrange(municipio, data)

print("Evolução da pandemia nos 5 maiores municípios:")
print(evolucao_grandes_centros)


# 2.4 Análise por região (DRS) -----------------------------------------------
# Comparando desempenho das regiões de saúde
resumo_drs <- covid %>%
  filter(data == "2020-08-03") %>%
  group_by(drs) %>%
  summarise(
    municipios = n(),                                    # número de municípios
    populacao_total = sum(populacao),
    casos_totais = sum(casos),
    obitos_totais = sum(obitos),
    casos_pc_regiao = (casos_totais / populacao_total) * 100000,
    obitos_pc_regiao = (obitos_totais / populacao_total) * 100000,
    letalidade_regiao = obitos_totais / casos_totais
  ) %>%
  arrange(desc(obitos_pc_regiao))

print("Análise por Departamento Regional de Saúde:")
print(resumo_drs)


